@model IReadOnlyList<Reservation>

<div class="upcoming-widget">
    <div class="upcoming-head">
        <span class="eyebrow">Canlı plan</span>
        <h3>@ViewData["WidgetTitle"]</h3>
        <small>@Model.Count rezervasyon · @Model.Sum(reservation => reservation.GuestCount) misafir</small>
    </div>

    @if (Model.Count == 0)
    {
        <p class="muted">Yaklaşan rezervasyon bulunmuyor. İlk masayı siz ayırın.</p>
    }
    else
    {
        <div class="upcoming-list">
            @foreach (var reservation in Model)
            {
                <partial name="_ReservationCard" model="reservation" />
            }
        </div>
    }

    <a class="text-link" asp-controller="Reservations" asp-action="Index">Tüm rezervasyonlar <span>→</span></a>
</div>
