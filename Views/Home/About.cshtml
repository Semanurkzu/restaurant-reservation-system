@{
    ViewData["Title"] = "Hakkımızda";
}

<section class="page-hero compact">
    <div class="container">
        <span class="eyebrow light">AHENK'in hikâyesi</span>
        <h1>Üç dost.<br /><em>Bir bağ.</em></h1>
        <p>Üniversitenin ilk gününde başlayan dostluğumuzun, aynı sofrada büyüyen hikâyesi.</p>
    </div>
</section>

<section class="section container two-column">
    <div>
        <span class="eyebrow">İsmin anlamı</span>
        <h2>Neden AHENK?</h2>
        <p>AHENK; üniversitenin ilk gününden beri ayrılmayan üç arkadaşın farklı karakterlerle kurduğu güçlü uyumu ve üç ayrı hikâyenin tek sofrada buluşmasını temsil ediyor. Zamansız ve zarif ismiyle restoranımızın sakin lüks yaklaşımını yansıtıyor.</p>
    </div>
    <aside class="info-panel">
        <span class="eyebrow">Proje ekibi</span>
        <ul class="team-list">
            <li><span>B</span><strong>Beyza</strong></li>
            <li><span>N</span><strong>Nisa</strong></li>
            <li><span>S</span><strong>Semanur</strong></li>
        </ul>
        <p class="muted">Üç hikâye, tek sofra.</p>
    </aside>
</section>

<section class="section section-soft">
    <div class="container roadmap">
        <span class="eyebrow">Yol haritası</span>
        <h2>Dönem boyunca gelişim</h2>
        <div class="roadmap-grid">
            <article><strong>01</strong><h3>MVC İskeleti</h3><p>Controller, View, responsive arayüz ve Razor.</p></article>
            <article><strong>02</strong><h3>Veritabanı</h3><p>Menü, masa, müşteri ve rezervasyon tabloları.</p></article>
            <article><strong>03</strong><h3>Kullanıcı Sistemi</h3><p>Üyelik, roller ve yönetici paneli.</p></article>
            <article><strong>04</strong><h3>Raporlama</h3><p>Doluluk, popüler yemek ve rezervasyon analizleri.</p></article>
        </div>
    </div>
</section>
