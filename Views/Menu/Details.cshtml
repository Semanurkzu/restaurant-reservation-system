@model MenuItem
@{
    ViewData["Title"] = Model.Name;
    var relatedItems = ViewData["RelatedItems"] as IReadOnlyList<MenuItem> ?? new List<MenuItem>();
}

<section class="detail-section">
    <div class="container detail-grid">
        <div class="detail-photo"><img src="@Url.Content(Model.ImagePath)" alt="@Model.Name tabak sunumu: @Model.Description" /></div>
        <div class="detail-copy">
            <span class="eyebrow">@Model.Category</span>
            @if (Model.IsChefSpecial) { <span class="badge">Şefin seçimi</span> }
            <h1>@Model.Name</h1>
            <p class="lead">@Model.Description</p>
            @if (!string.IsNullOrWhiteSpace(Model.InspiredBy))
            {
                <p class="detail-inspiration"><span>İlham veren şef</span><strong>@Model.InspiredBy</strong></p>
            }
            <div class="price">@Model.Price.ToString("N0") ₺</div>
            <p>Yemeğimiz sipariş üzerine hazırlanır. Alerjen veya özel beslenme tercihleriniz için servis ekibimize bilgi verebilirsiniz.</p>
            <div class="hero-actions">
                <a class="button" asp-controller="Reservations" asp-action="Create">Masa Ayır</a>
                <a class="text-link" asp-action="Index">← Menüye dön</a>
            </div>
        </div>
    </div>
</section>

@if (relatedItems.Count > 0)
{
    <section class="section container related-section">
        <div class="section-heading menu-selection-heading"><div><span class="eyebrow">@Model.Category</span><h2>Bunları da beğenebilirsiniz</h2></div></div>
        <div class="menu-list">
            @foreach (var item in relatedItems)
            {
                <partial name="_MenuLine" model="item" />
            }
        </div>
    </section>
}
