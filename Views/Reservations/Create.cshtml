@model Reservation
@{
    ViewData["Title"] = "Masa Ayır";
    var guestOptions = Enumerable.Range(1, 12).Select(i => new SelectListItem($"{i} kişi", i.ToString()));
    var seatingOptions = new SelectList(Reservation.SeatingAreas);
}

<section class="form-section">
    <div class="container form-grid">
        <div class="form-intro">
            <span class="eyebrow">Sofranız hazır</span>
            <h1>Masa ayırtın</h1>
            <p>Tarih ve kişi bilgilerinizi bırakın; rezervasyon talebinizi hemen oluşturalım.</p>
            <div class="contact-card"><span>Akşam servisi</span><strong>18.00 - 00.00</strong><span>Rezervasyon hattı</span><strong>+90 555 000 00 00</strong></div>
            @await Component.InvokeAsync("UpcomingReservations", new { count = 2, title = "Sıradaki masalar" })
        </div>
        @using (Html.BeginForm("Create", "Reservations", FormMethod.Post, new { @class = "reservation-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

            <div class="field full">
                @Html.LabelFor(m => m.CustomerName)
                @Html.TextBoxFor(m => m.CustomerName, new { placeholder = "Adınız ve soyadınız" })
                @Html.ValidationMessageFor(m => m.CustomerName)
            </div>
            <div class="field full">
                @Html.LabelFor(m => m.Phone)
                @Html.TextBoxFor(m => m.Phone, new { placeholder = "05xx xxx xx xx", type = "tel" })
                @Html.ValidationMessageFor(m => m.Phone)
            </div>
            <div class="field">
                @Html.LabelFor(m => m.ReservationDate)
                @Html.TextBoxFor(m => m.ReservationDate, "{0:yyyy-MM-ddTHH:mm}", new { type = "datetime-local" })
                @Html.ValidationMessageFor(m => m.ReservationDate)
            </div>
            <div class="field">
                @Html.LabelFor(m => m.GuestCount)
                @Html.DropDownListFor(m => m.GuestCount, guestOptions)
                @Html.ValidationMessageFor(m => m.GuestCount)
            </div>
            <div class="field full">
                @Html.LabelFor(m => m.SeatingArea)
                @Html.DropDownListFor(m => m.SeatingArea, seatingOptions, "Oturma alanı seçiniz")
                @Html.ValidationMessageFor(m => m.SeatingArea)
            </div>
            <div class="field full field-check">
                @Html.CheckBoxFor(m => m.IsSpecialOccasion)
                @Html.LabelFor(m => m.IsSpecialOccasion)
            </div>
            <div class="field full">
                @Html.LabelFor(m => m.Note)
                @Html.TextAreaFor(m => m.Note, 4, 0, new { placeholder = "Doğum günü, alerji veya masa tercihi..." })
                @Html.ValidationMessageFor(m => m.Note)
            </div>
            <button class="button full" type="submit">Rezervasyon Talebi Oluştur</button>
            <small class="form-hint">Talebiniz “Bekliyor” durumunda kaydedilir ve rezervasyon listesinde hemen görünür.</small>
        }
    </div>
</section>
